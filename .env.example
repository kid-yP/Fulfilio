# Copy to .env and fill in real values before running docker compose up

# Postgres (matches docker-compose defaults — change for prod)
DATABASE_URL=postgresql://fulfilio:fulfilio@localhost:5432/fulfilio

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Stripe (test mode keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# App
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# AI (leave unset to use the deterministic template fallback for daily-summary/triage)
# ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5
